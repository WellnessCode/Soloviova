# ШАБЛОН. Скопируйте этот файл в новый файл с именем .env
# и вставьте свои реальные значения справа от знака =
# Файл .env НЕ попадёт в git (защищён .gitignore).

# Токен бота-тайм-менеджера Time_manager_Anna_bot (из @BotFather)
TIME_MANAGER_BOT_TOKEN=сюда_вставьте_токен_из_BotFather

# Ключ Anthropic API (из https://console.anthropic.com — раздел API Keys)
ANTHROPIC_API_KEY=сюда_вставьте_ключ_Anthropic_API

# Google Календарь: содержимое token.json (получить через auth_google.py, см. SETUP_GOOGLE.md)
GOOGLE_TOKEN_JSON=

# (необязательно) ID календаря; по умолчанию основной календарь аккаунта
GOOGLE_CALENDAR_ID=primary

# (необязательно) Часовой пояс
TZ_NAME=Europe/Kyiv

# (необязательно) Ваш chat_id в Telegram для напоминаний.
# Можно не заполнять — бот запомнит его сам, когда вы нажмёте /start.
OWNER_CHAT_ID=

# Токен бота-маркетолога (нужен только для marketolog_bot.py)
MARKETOLOG_BOT_TOKEN=
